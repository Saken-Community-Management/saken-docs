# Supabase project URL (used only for the auth gate). https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (used only for auth; sent to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Access allowlist — emails permitted to read the docs. Comma-, space-, or
# newline-separated. The docs site has NO database; this and the two Supabase
# auth vars above are the only env vars it reads.
SAKEN_ADMIN_ALLOWLIST=
